# Copy to .env before running `docker compose up`.
# These are LOCAL DEV defaults only - never used in staging/prod, where
# secrets come from AWS Secrets Manager via the External Secrets Operator
# (see k8s/base/external-secrets.yaml and docs/15-security-hardening.md).

POSTGRES_USER=scalecart
POSTGRES_PASSWORD=scalecart_dev_password
POSTGRES_DB=postgres

JWT_SECRET=dev-secret-change-me

MONGO_INITDB_ROOT_USERNAME=scalecart
MONGO_INITDB_ROOT_PASSWORD=scalecart_dev_password

# Every service's Kafka client points here in docker-compose.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
